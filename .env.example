# Copie este arquivo para .env e preencha com os valores reais.
# Nunca envie o .env para o GitHub. Em produção, cadastre as mesmas variáveis
# na Netlify: Site configuration → Environment variables.

# Supabase (contas e banco de dados) — valores públicos, protegidos por RLS
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Cakto (pagamento) — SECRETO: usado só pela função da Netlify, nunca no navegador
CAKTO_CLIENT_ID=seu-client-id
CAKTO_CLIENT_SECRET=seu-client-secret
